# Local API
PORT=8787
DATABASE_PATH=./data/model-radar.sqlite
ADMIN_TOKEN=replace-with-a-long-local-token
# Optional locally: if omitted, the API reads api_key from ~/.mmx/config.json.
# Set this explicitly in Cloudflare as the Worker Secret MINIMAX_API_KEY.
# MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7-highspeed
