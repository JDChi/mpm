    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": [],
    "skipLibCheck": true
  },
  "include": [
    "worker-configuration.d.ts",
